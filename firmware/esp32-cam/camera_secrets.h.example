#pragma once

// Copy this file to camera_secrets.h and fill in values for your network.
// camera_secrets.h is ignored by Git so credentials are not committed.
#define CAMERA_WIFI_SSID ""
#define CAMERA_WIFI_PASSWORD ""

// For a Flask server running on your laptop, use the laptop's LAN IPv4
// address, not localhost or 127.0.0.1. This first version uses plain HTTP.
#define CAMERA_SERVER_HOST "192.168.1.100"
#define CAMERA_SERVER_PORT 5000
#define CAMERA_DEVICE_API_KEY "replace-with-the-server-device-api-key"
